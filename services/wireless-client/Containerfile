FROM docker.io/library/ubuntu:24.04

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates iproute2 iputils-ping isc-dhcp-client iw wpasupplicant && \
    rm -rf /var/lib/apt/lists/*

COPY --chmod=755 bootstrap.sh /usr/local/bin/wireless-client

CMD ["/usr/local/bin/wireless-client"]

LABEL org.opencontainers.image.source=https://github.com/gdcs-dev/vcpe
LABEL org.opencontainers.image.description="Wireless station client for the vCPE project"