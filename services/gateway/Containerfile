FROM docker.io/library/ubuntu:24.04 AS hostapd-builder

ARG HOSTAPD_VERSION=2.11
ARG HOSTAPD_SHA256=2b3facb632fd4f65e32f4bf82a76b4b72c501f995a4f62e330219fe7aed1747a
ARG WPA_SUPPLICANT_SHA256=912ea06f74e30a8e36fbb68064d6cdff218d8d591db0fc5d75dee6c81ac7fc0a

RUN apt-get update && \
   DEBIAN_FRONTEND=noninteractive apt-get -y install --no-install-recommends \
   build-essential ca-certificates curl libdbus-1-dev libnl-3-dev libnl-genl-3-dev libnl-route-3-dev libssl-dev pkg-config && \
   rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
RUN curl -fsSLo hostapd.tar.gz "https://w1.fi/releases/hostapd-${HOSTAPD_VERSION}.tar.gz" && \
   echo "${HOSTAPD_SHA256}  hostapd.tar.gz" | sha256sum -c - && \
   tar -xzf hostapd.tar.gz

WORKDIR /tmp/hostapd-${HOSTAPD_VERSION}/hostapd
RUN cp defconfig .config && \
   printf '\nCONFIG_DRIVER_NONE=y\nCONFIG_IEEE80211N=y\nCONFIG_IEEE80211AC=y\nCONFIG_IEEE80211AX=y\nCONFIG_SAE=y\n' >> .config && \
   make -j"$(nproc)"

WORKDIR /tmp
RUN curl -fsSLo wpa_supplicant.tar.gz "https://w1.fi/releases/wpa_supplicant-${HOSTAPD_VERSION}.tar.gz" && \
   echo "${WPA_SUPPLICANT_SHA256}  wpa_supplicant.tar.gz" | sha256sum -c - && \
   tar -xzf wpa_supplicant.tar.gz

WORKDIR /tmp/wpa_supplicant-${HOSTAPD_VERSION}/wpa_supplicant
RUN cp defconfig .config && \
   printf '\nCONFIG_MESH=y\nCONFIG_SAE=y\nCONFIG_CTRL_IFACE=y\n' >> .config && \
   make -j"$(nproc)" wpa_supplicant wpa_cli

FROM docker.io/library/ubuntu:24.04

ARG TARGETOS
ARG TARGETARCH

RUN apt-get update && apt-get upgrade -y && \
   DEBIAN_FRONTEND=noninteractive apt-get -y install ca-certificates

RUN echo "deb [trusted=yes] https://gdcs-dev.github.io/debian stable main" | tee /etc/apt/sources.list.d/custom-packages.list

RUN apt-get update && \
   DEBIAN_FRONTEND=noninteractive apt-get -y install \
   rbus parodus rbus-elements telemetry utopia webcfg parodus2rbus hermesfs \
   collectd collectd-rbus-plugin rrdtool \
   iptables net-tools dnsutils dnsmasq systemd-sysv iputils-ping syslog-ng jq netplan.io iw hostapd \
   isc-dhcp-client \
   libcjson1 libmsgpackc2 curl liblog4c3t64 libjansson4 libspdlog-dev && \
   rm -rf /var/lib/apt/lists/*

COPY --from=hostapd-builder /tmp/hostapd-2.11/hostapd/hostapd /usr/sbin/hostapd
COPY --from=hostapd-builder /tmp/wpa_supplicant-2.11/wpa_supplicant/wpa_supplicant /usr/local/sbin/wpa_supplicant
COPY --from=hostapd-builder /tmp/wpa_supplicant-2.11/wpa_supplicant/wpa_cli /usr/local/bin/wpa_cli

COPY --chmod=600 container/50-cloud-init.yaml /etc/netplan/
COPY --chmod=644 container/device.properties /etc/
COPY --chmod=644 container/output.json /opt/
COPY --chmod=644 container/webconfig.properties /etc/webconfig.properties
# COPY --chmod=644 container/elements.json /etc/rbus-elements/elements.json
# COPY --chmod=644 container/rbus-elements.service /etc/systemd/system/rbus-elements.service
COPY --chmod=644 container/webconfig.service /etc/systemd/system/webconfig.service
COPY --chmod=644 container/telemetry-agent-otlp.service /etc/systemd/system/telemetry-agent-otlp.service
RUN mkdir -p /etc/collectd
COPY --chmod=644 container/collectd.conf /etc/collectd/collectd.conf
RUN systemctl enable parodus
RUN systemctl enable parodus2rbus
RUN systemctl enable rbus
# RUN systemctl enable rbus-elements
RUN systemctl enable webconfig
RUN systemctl enable hermesfs
RUN systemctl enable collectd
COPY --chmod=644 container/syscfg.service /usr/lib/systemd/system/
COPY --chmod=755 container/syscfg_init.sh /usr/local/bin/
RUN systemctl enable syscfg
RUN mkdir -p /nvram
RUN systemctl enable telemetry2_0


COPY container/platforms/${TARGETOS}-${TARGETARCH}/runtime-init-gateway /usr/local/bin/runtime-init-gateway
COPY container/platforms/${TARGETOS}-${TARGETARCH}/vcpe-healthd /usr/local/bin/vcpe-healthd
RUN mkdir -p /etc/rdk-otel && touch /etc/rdk-otel/enabled
COPY --chmod=644 container/agent.yaml /etc/rdk-otel/agent.yaml
COPY container/vcpe-healthd.service /etc/systemd/system/vcpe-healthd.service
COPY container/entrypoint.sh /usr/local/bin/gateway-entrypoint.sh
COPY container/hostapd-wrapper.sh /usr/local/bin/vcpe-hostapd
COPY --chmod=644 container/vcpe-hostapd.service /etc/systemd/system/vcpe-hostapd.service
COPY container/mesh-wrapper.sh /usr/local/bin/vcpe-mesh
COPY --chmod=644 container/vcpe-mesh.service /etc/systemd/system/vcpe-mesh.service
COPY container/health-probe.sh /usr/local/bin/gateway-health-probe
COPY container/healthcheck.sh /usr/local/bin/healthcheck.sh
RUN chmod +x /usr/local/bin/runtime-init-gateway /usr/local/bin/vcpe-healthd /usr/local/bin/gateway-entrypoint.sh /usr/local/bin/vcpe-hostapd /usr/local/bin/vcpe-mesh /usr/local/bin/gateway-health-probe /usr/local/bin/healthcheck.sh
RUN systemctl enable vcpe-healthd.service
RUN systemctl enable vcpe-hostapd.service
RUN systemctl enable vcpe-mesh.service
RUN systemctl disable dnsmasq
RUN systemctl disable hostapd.service
RUN systemctl mask systemd-networkd-wait-online

RUN printf '#!/bin/sh\nmkdir -p /root/.rustup-tmp\nexport TMPDIR=/root/.rustup-tmp\ncurl --proto '\''=https'\'' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y\nprintf '\''[net]\\ngit-fetch-with-cli = true\\n'\'' > $HOME/.cargo/config.toml\n' > /usr/bin/install-rust.sh && \
   chmod +x /usr/bin/install-rust.sh

ENTRYPOINT ["/usr/local/bin/runtime-init-gateway"]
CMD ["/usr/local/bin/gateway-entrypoint.sh"]
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 CMD ["/usr/local/bin/healthcheck.sh"]

LABEL org.opencontainers.image.source=https://github.com/gdcs-dev/vcpe
LABEL org.opencontainers.image.description="Gateway Container from the vCPE project"
LABEL org.gdcs-dev.vcpe.gateway.mesh-sae=1