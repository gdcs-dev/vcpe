FROM docker.io/library/ubuntu:24.04

ARG TARGETOS
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get upgrade -y && \
   DEBIAN_FRONTEND=noninteractive apt-get -y install ca-certificates

RUN echo "deb [trusted=yes] https://gdcs-dev.github.io/debian stable main" | tee /etc/apt/sources.list.d/custom-packages.list


# Match routerd/Dockerfile.test: thin Rust dev image with the runtime tooling
# routerd's controllers need (netlink, ping, ps/net-tools, dnsutils, udhcpc,
# busybox/dnsmasq for the dhcp-* controllers). Source is NOT copied; it is
# bind-mounted at runtime so the workspace stays a single source of truth.
RUN apt-get update \
   && apt-get install -y --no-install-recommends \
   iproute2 \
   iputils-ping \
   procps \
   net-tools \
   dnsutils \
   udhcpc \
   busybox \
   dnsmasq \
   ca-certificates \
   routerd \
   && rm -rf /var/lib/apt/lists/*

COPY container/platforms/${TARGETOS}-${TARGETARCH}/runtime-init-routerd /usr/local/bin/runtime-init-routerd
COPY container/platforms/${TARGETOS}-${TARGETARCH}/vcpe-healthd /usr/local/bin/vcpe-healthd
COPY container/entrypoint.sh /usr/local/bin/routerd-legacy-entrypoint.sh
COPY container/health-probe.sh /usr/local/bin/routerd-health-probe
COPY container/healthcheck.sh /usr/local/bin/healthcheck.sh
# Static composition-root descriptor (deployment.json/components/profiles.json/
# identity.json): which routerd components run in-process. This is fixed by
# the binary, not the manifest, so it ships baked into the image rather than
# being rendered per-deployment; the manifest-rendered desired-state config
# (etc/routerd/config.json) is mounted separately at runtime alongside it.
COPY container/provisioning/ /etc/routerd/

RUN chmod +x /usr/local/bin/runtime-init-routerd /usr/local/bin/vcpe-healthd \
              /usr/local/bin/routerd-legacy-entrypoint.sh \
              /usr/local/bin/routerd-health-probe \
              /usr/local/bin/healthcheck.sh

ENTRYPOINT ["/usr/local/bin/runtime-init-routerd"]
CMD ["/usr/local/bin/routerd-legacy-entrypoint.sh"]
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD ["/usr/local/bin/healthcheck.sh"]
