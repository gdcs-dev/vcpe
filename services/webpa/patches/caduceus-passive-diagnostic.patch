## -0,0 +1,145 ##
+// SPDX-FileCopyrightText: 2026 Comcast Cable Communications Management, LLC
+// SPDX-License-Identifier: Apache-2.0
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"net/http"
+	"regexp"
+	"sort"
+	"sync"
+	"time"
+
+	"github.com/gorilla/mux"
+	"github.com/xmidt-org/wrp-go/v3"
+)
+
+const (
+	diagnosticJourney        = "cpe-webpa-callback"
+	defaultDiagnosticRecords = 32
+	defaultDiagnosticTTL     = 30 * time.Second
+	maxDiagnosticPayload     = 1024
+)
+
+var diagnosticCorrelationID = regexp.MustCompile(`^[a-f0-9]{64}$`)
+
+// DiagnosticConfig is opt-in. Disabled instrumentation has no routing,
+// delivery, or externally-visible endpoint behavior.
+type DiagnosticConfig struct {
+	Enabled    bool
+	MaxRecords int
+	RecordTTL  time.Duration
+}
+
+// DiagnosticObservation exposes only the bounded routing outcome required by
+// the diagnostic coordinator. It intentionally excludes event content,
+// callback addresses, registration data, and credentials.
+type DiagnosticObservation struct {
+	CorrelationID string    `json:"correlationId"`
+	State         string    `json:"state"`
+	ObservedAt    time.Time `json:"observedAt"`
+}
+
+// DiagnosticObserver records reserved diagnostic markers after existing
+// sender selection. It does not change the sender's matching or delivery.
+type DiagnosticObserver struct {
+	mutex   sync.Mutex
+	now     func() time.Time
+	maximum int
+	ttl     time.Duration
+	records map[string]DiagnosticObservation
+}
+
+func NewDiagnosticObserver(config DiagnosticConfig) *DiagnosticObserver {
+	if !config.Enabled {
+		return nil
+	}
+	if config.MaxRecords <= 0 || config.MaxRecords > defaultDiagnosticRecords {
+		config.MaxRecords = defaultDiagnosticRecords
+	}
+	if config.RecordTTL <= 0 || config.RecordTTL > defaultDiagnosticTTL {
+		config.RecordTTL = defaultDiagnosticTTL
+	}
+	return &DiagnosticObserver{
+		now:     time.Now,
+		maximum: config.MaxRecords,
+		ttl:     config.RecordTTL,
+		records: make(map[string]DiagnosticObservation, config.MaxRecords),
+	}
+}
+
+func (observer *DiagnosticObserver) Observe(message *wrp.Message, selected int) {
+	if observer == nil {
+		return
+	}
+	correlationID, ok := diagnosticMarker(message)
+	if !ok || selected < 1 {
+		return
+	}
+	now := observer.now().UTC()
+	observer.mutex.Lock()
+	defer observer.mutex.Unlock()
+	observer.expire(now)
+	if len(observer.records) >= observer.maximum {
+		observer.evictOldest()
+	}
+	observer.records[correlationID] = DiagnosticObservation{CorrelationID: correlationID, State: "selected", ObservedAt: now}
+}
+
+func (observer *DiagnosticObserver) ServeHTTP(writer http.ResponseWriter, request *http.Request) {
+	correlationID := mux.Vars(request)["id"]
+	if !diagnosticCorrelationID.MatchString(correlationID) {
+		http.NotFound(writer, request)
+		return
+	}
+	now := observer.now().UTC()
+	observer.mutex.Lock()
+	observer.expire(now)
+	observation, ok := observer.records[correlationID]
+	observer.mutex.Unlock()
+	if !ok {
+		http.NotFound(writer, request)
+		return
+	}
+	writer.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(writer).Encode(observation)
+}
+
+func (observer *DiagnosticObserver) expire(now time.Time) {
+	for correlationID, observation := range observer.records {
+		if !now.Before(observation.ObservedAt.Add(observer.ttl)) {
+			delete(observer.records, correlationID)
+		}
+	}
+}
+
+func (observer *DiagnosticObserver) evictOldest() {
+	keys := make([]string, 0, len(observer.records))
+	for correlationID := range observer.records {
+		keys = append(keys, correlationID)
+	}
+	sort.Slice(keys, func(left, right int) bool {
+		return observer.records[keys[left]].ObservedAt.Before(observer.records[keys[right]].ObservedAt)
+	})
+	if len(keys) > 0 {
+		delete(observer.records, keys[0])
+	}
+}
+
+func diagnosticMarker(message *wrp.Message) (string, bool) {
+	if message == nil || message.Type != wrp.SimpleEventMessageType || message.ContentType != wrp.MimeTypeJson || len(message.Payload) == 0 || len(message.Payload) > maxDiagnosticPayload {
+		return "", false
+	}
+	var marker struct {
+		Diagnostic    string `json:"vcpe_diagnostic"`
+		CorrelationID string `json:"correlation_id"`
+	}
+	decoder := json.NewDecoder(bytes.NewReader(message.Payload))
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(&marker) != nil || decoder.Decode(&struct{}{}) != io.EOF || marker.Diagnostic != diagnosticJourney || !diagnosticCorrelationID.MatchString(marker.CorrelationID) {
+		return "", false
+	}
+	return marker.CorrelationID, true
+}
