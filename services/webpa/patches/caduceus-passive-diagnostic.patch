## -0,0 +1,71 ##
+// SPDX-FileCopyrightText: 2026 Comcast Cable Communications Management, LLC
+// SPDX-License-Identifier: Apache-2.0
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gorilla/mux"
+	"github.com/xmidt-org/wrp-go/v3"
+)
+
+func diagnosticMessage(t *testing.T, correlationID string) *wrp.Message {
+	t.Helper()
+	payload, err := json.Marshal(map[string]string{"vcpe_diagnostic": diagnosticJourney, "correlation_id": correlationID})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &wrp.Message{Type: wrp.SimpleEventMessageType, ContentType: wrp.MimeTypeJson, Payload: payload}
+}
+
+func TestDiagnosticObserverRecordsSelectedMarker(t *testing.T) {
+	now := time.Date(2026, time.August, 17, 12, 0, 0, 0, time.UTC)
+	observer := NewDiagnosticObserver(DiagnosticConfig{Enabled: true, MaxRecords: 1, RecordTTL: time.Second})
+	observer.now = func() time.Time { return now }
+	correlationID := strings.Repeat("a", 64)
+	observer.Observe(diagnosticMessage(t, correlationID), 1)
+
+	request := httptest.NewRequest(http.MethodGet, "/api/v4/diagnostics/correlation/"+correlationID, nil)
+	request = mux.SetURLVars(request, map[string]string{"id": correlationID})
+	response := httptest.NewRecorder()
+	observer.ServeHTTP(response, request)
+	if response.Code != http.StatusOK {
+		t.Fatalf("status = %d", response.Code)
+	}
+	var observation DiagnosticObservation
+	if err := json.NewDecoder(response.Body).Decode(&observation); err != nil {
+		t.Fatal(err)
+	}
+	if observation.CorrelationID != correlationID || observation.State != "selected" || !observation.ObservedAt.Equal(now) {
+		t.Fatalf("observation = %+v", observation)
+	}
+}
+
+func TestDiagnosticObserverIgnoresNormalEventsAndExpiresRecords(t *testing.T) {
+	now := time.Date(2026, time.August, 17, 12, 0, 0, 0, time.UTC)
+	observer := NewDiagnosticObserver(DiagnosticConfig{Enabled: true, MaxRecords: 1, RecordTTL: time.Second})
+	observer.now = func() time.Time { return now }
+	observer.Observe(&wrp.Message{Type: wrp.SimpleEventMessageType, ContentType: wrp.MimeTypeJson, Payload: []byte(`{"ordinary":true}`)}, 1)
+	if len(observer.records) != 0 {
+		t.Fatalf("normal event was recorded: %+v", observer.records)
+	}
+	correlationID := strings.Repeat("b", 64)
+	observer.Observe(diagnosticMessage(t, correlationID), 0)
+	if len(observer.records) != 0 {
+		t.Fatalf("unselected event was recorded: %+v", observer.records)
+	}
+	observer.Observe(diagnosticMessage(t, correlationID), 1)
+	now = now.Add(2 * time.Second)
+	request := httptest.NewRequest(http.MethodGet, "/", nil)
+	request = mux.SetURLVars(request, map[string]string{"id": correlationID})
+	response := httptest.NewRecorder()
+	observer.ServeHTTP(response, request)
+	if response.Code != http.StatusNotFound {
+		t.Fatalf("expired record status = %d", response.Code)
+	}
+}
